---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

// Mesma barra do site principal: marca, links de seção, ação de LinkedIn.
const links = [
  { texto: 'Posts', href: '/#posts-recentes' },
  { texto: 'Série', href: '/curso-mdm-como-codigo/' },
  { texto: 'Sobre', href: 'https://deividsantos.com.br/#sobre' },
  { texto: 'Site', href: 'https://deividsantos.com.br' },
];
---

<div class="barra">
  <a class="marca" href="/" aria-label="Blog de Deívid Santos, início">
    <img src="/favicon.png" width="40" height="40" alt="" />
    <span>Blog</span>
  </a>
  <ul class="sl-hidden md:sl-flex print:hidden">
    {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
  </ul>
  <div class="acoes sl-flex print:hidden">
    <Search />
    <details class="menu-movel md:sl-hidden">
      <summary aria-label="Abrir menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </summary>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
        <li><a href="https://www.linkedin.com/in/dnsto">LinkedIn</a></li>
      </ul>
    </details>
    <div class="sl-hidden md:sl-flex acoes-extra">
      <ThemeSelect />
      <a class="botao-linkedin" href="https://www.linkedin.com/in/dnsto">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .barra {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      height: 100%;
      padding-top: 6px;
      box-sizing: border-box;
    }
    .marca {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--sl-color-white);
      font-weight: 600;
      font-size: 1.1rem;
      min-height: 2.75rem;
    }
    /* Mesmo grid do site: marca à esquerda, links realmente centralizados, ações à direita */
    @media (min-width: 50rem) {
      .barra {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
      }
      .acoes {
        justify-self: end;
      }
    }
    ul {
      gap: 0.5rem 1.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    ul a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      font-family: var(--sl-font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--sl-color-gray-2);
      text-decoration: none;
    }
    ul a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
      text-decoration-color: var(--amarelo);
      text-decoration-thickness: 3px;
      text-underline-offset: 6px;
    }
    .menu-movel {
      position: relative;
    }
    .menu-movel summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 2px solid var(--sl-color-gray-5);
      color: var(--sl-color-white);
      cursor: pointer;
      list-style: none;
    }
    .menu-movel summary::-webkit-details-marker {
      display: none;
    }
    .menu-movel ul {
      position: absolute;
      inset-inline-end: 0;
      top: calc(100% + 0.5rem);
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 0;
      min-width: 12rem;
      padding: 0.5rem 1rem;
      background: var(--sl-color-black);
      border: 2px solid var(--sl-color-gray-5);
    }
    .acoes,
    .acoes-extra {
      gap: 0.75rem;
      align-items: center;
    }
    .botao-linkedin {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 1rem;
      background: var(--sl-color-white);
      color: var(--sl-color-black);
      font-family: var(--sl-font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .botao-linkedin:hover {
      background: var(--amarelo);
      color: #121417;
    }
  }
</style>
